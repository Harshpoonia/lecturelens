# Copy to .streamlit/secrets.toml for local use, or paste into
# Streamlit Community Cloud → App settings → Secrets.
# NEVER commit the real secrets.toml.

GEMINI_API_KEY = "your-new-gemini-key"
GEMINI_MODEL = "gemini-3.5-flash"

# Public demo protection: max AI requests per visitor session on your key (0 = unlimited)
SESSION_AI_CALL_LIMIT = "40"
# Let visitors paste their own key (recommended for public apps)
ALLOW_USER_API_KEY = "true"

# Optional: residential proxy so YouTube doesn't block caption downloads from the cloud
# WEBSHARE_PROXY_USERNAME = ""
# WEBSHARE_PROXY_PASSWORD = ""
# TRANSCRIPT_PROXY_URL = "http://user:pass@host:port"

# GITHUB_URL = "https://github.com/<you>/youtube-ai-learning-assistant"
