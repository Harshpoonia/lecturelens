# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your-new-gemini-key
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_MODEL_CHOICES=gemini-3.5-flash,gemini-3.1-flash-lite

APP_TITLE=LectureLens
MAX_TRANSCRIPT_CHARS=200000
AI_MAX_RETRIES=3
CACHE_TTL_SECONDS=21600

# Public deployment controls
ALLOW_USER_API_KEY=true
SESSION_AI_CALL_LIMIT=40
ENABLE_GEMINI_VIDEO_FALLBACK=true

# Caption language preference (comma-separated ISO codes)
TRANSCRIPT_LANGUAGES=en,hi

# Optional proxy for youtube-transcript-api (YouTube blocks most cloud IPs)
# WEBSHARE_PROXY_USERNAME=
# WEBSHARE_PROXY_PASSWORD=
# TRANSCRIPT_PROXY_URL=http://user:pass@host:port

# GITHUB_URL=https://github.com/<you>/youtube-ai-learning-assistant
